# ---- LLM providers (at least one required; the router falls back in this order) ----
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,minimax/minimax-m2.7:free

# Optional fallbacks. Free tiers rate-limit constantly, so adding these is worth it.
GROQ_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Confidence tuning ----
AUTO_ACCEPT_THRESHOLD=0.85
REVIEW_THRESHOLD=0.60
W_SELF_REPORTED=0.30
W_AGREEMENT=0.30
W_RULES=0.40
EXTRACTION_PASSES=2

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
