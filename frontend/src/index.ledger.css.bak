/* ==========================================================================
   Ledger theme.
   Deliberately NOT the default dark-navy/blue-glow/rounded-pill "AI product"
   look. This is a back-office finance tool, so it borrows from the thing it
   replaces: paper, ink, ruled lines, a stamped accent colour, tabular
   numerals. Warm cream background, hairline borders, sharp corners, a serif
   for headings and mono for anything that's a number or an id.
   ========================================================================== */
:root {
  --bg:      #f2ede2;
  --paper:   #fbf8f0;
  --panel-2: #e9e2d0;
  --border:  #d3c7ab;
  --border-strong: #b7a97e;
  --ink:     #2a2417;
  --muted:   #7c725c;
  --accent:  #8a3a1f;   /* stamped rust-red */
  --accent-ink: #fdf3ec;
  --green:   #3c6b3a;
  --amber:   #96690f;
  --red:     #a3341d;
  --radius:  2px;
  color-scheme: light;

  --serif: 'Iowan Old Style', 'Sitka Text', Georgia, 'Times New Roman', serif;
  --sans: ui-sans-serif, Calibri, 'Segoe UI', Roboto, sans-serif;
  --mono: ui-monospace, 'Cascadia Mono', 'SFMono-Regular', Consolas, monospace;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  background-image:
    linear-gradient(var(--panel-2) 1px, transparent 1px);
  background-size: 100% 32px;
  color: var(--ink);
  font: 15px/1.55 var(--sans);
}

button { font: inherit; cursor: pointer; }
input { font: inherit; }
code { font-family: var(--mono); }

.app { max-width: 1180px; margin: 0 auto; padding: 32px 24px 90px; }

/* ---------- header ---------- */
.head {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  padding-bottom: 18px; margin-bottom: 6px;
  border-bottom: 3px double var(--border-strong);
}
.head h1 {
  margin: 0 0 6px; font: 600 24px/1.2 var(--serif); letter-spacing: -0.01em; color: var(--ink);
}
.head p { margin: 0; color: var(--muted); font-size: 13.5px; max-width: 600px; }

.health { display: flex; gap: 8px; flex-wrap: wrap; }
.pill {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--paper); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 4px 10px;
  font: 11px/1 var(--mono); text-transform: uppercase; letter-spacing: .04em; color: var(--muted);
}
.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
.dot.ok { background: var(--green); }
.dot.off { background: var(--red); }

/* ---------- dropzone ---------- */
.drop {
  margin: 24px 0;
  border: 1px solid var(--border-strong);
  outline: 1px solid var(--paper);
  outline-offset: -6px;
  border-radius: var(--radius);
  background: var(--paper);
  padding: 34px 24px;
  text-align: center;
}
.drop.over { border-color: var(--accent); background: var(--accent-ink); }
.drop h2 { margin: 0 0 6px; font: 600 17px/1.2 var(--serif); }
.drop p { margin: 0 0 16px; color: var(--muted); font-size: 13px; }

.btn {
  background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent);
  border-radius: var(--radius); padding: 8px 18px; font-weight: 600; font-size: 13.5px;
  letter-spacing: .01em;
}
.btn:hover:not(:disabled) { background: #712e17; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn.ghost { background: transparent; border: 1px solid var(--border-strong); color: var(--ink); font-weight: 500; }
.btn.ghost:hover { background: var(--panel-2); }

/* ---------- tabs ---------- */
.tabs { display: flex; gap: 2px; margin: 26px 0 0; border-bottom: 1px solid var(--border-strong); }
.tab {
  background: none; border: 1px solid transparent; border-bottom: 0;
  padding: 8px 18px; color: var(--muted); font: 600 12.5px/1 var(--mono);
  text-transform: uppercase; letter-spacing: .06em;
  border-radius: var(--radius) var(--radius) 0 0; margin-bottom: -1px;
}
.tab.active { color: var(--ink); background: var(--paper); border-color: var(--border-strong); border-bottom-color: var(--paper); }
.tab:hover:not(.active) { color: var(--ink); }

/* ---------- history ---------- */
.hist-row {
  display: flex; align-items: center; gap: 4px;
  border-bottom: 1px solid var(--panel-2);
  padding: 2px 0;
}
.hist-row.active { background: var(--panel-2); }
.hist-main {
  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: stretch; gap: 3px;
  background: transparent; border: 0; padding: 8px 9px; text-align: left; color: var(--ink);
}
.hist-main:hover { background: var(--panel-2); }
.hist-row2 { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; }
.hist-meta { font: 11px var(--mono); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.hist-confirm { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted); padding-right: 8px; white-space: nowrap; flex-shrink: 0; }
.linkbtn.danger { color: var(--red); }

/* ---------- queue ---------- */
.queue-layout { display: grid; grid-template-columns: 280px 1fr; gap: 18px; align-items: start; }
@media (max-width: 820px) { .queue-layout { grid-template-columns: 1fr; } }

.queue-list {
  display: flex; flex-direction: column; gap: 0;
  max-height: 74vh; overflow-y: auto;
  background: var(--paper); border: 1px solid var(--border);
  padding: 4px;
}
.queue-row {
  display: flex; align-items: center; gap: 9px;
  background: transparent; border: 0; border-bottom: 1px solid var(--panel-2);
  padding: 9px 8px; text-align: left; color: var(--ink); width: 100%;
}
.queue-row:last-child { border-bottom: 0; }
.queue-row:hover { background: var(--panel-2); }
.queue-row.active { background: var(--accent-ink); }
.queue-name { flex: 1; min-width: 0; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.queue-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--muted); }
.queue-dot.queued { background: var(--muted); }
.queue-dot.processing { background: var(--accent); }
.queue-dot.done { background: var(--green); }
.queue-dot.error { background: var(--red); }
.queue-badge {
  font: 700 10.5px/1 var(--mono); text-transform: uppercase; letter-spacing: .04em;
  padding: 3px 6px; border-radius: var(--radius); flex-shrink: 0; border: 1px solid transparent;
}
.queue-badge.green { color: var(--green); border-color: var(--green); }
.queue-badge.amber { color: var(--amber); border-color: var(--amber); }
.queue-badge.red   { color: var(--red);   border-color: var(--red); }

.queue-detail { min-width: 0; }

/* ---------- summary ---------- */
.summary { display: flex; flex-wrap: wrap; margin-bottom: 20px; border: 1px solid var(--border); }
.stat { flex: 1 1 160px; background: var(--paper); padding: 13px 16px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.stat:last-child { border-right: 0; }
.stat .k { color: var(--muted); font: 10.5px var(--mono); text-transform: uppercase; letter-spacing: .07em; }
.stat .v { font: 600 22px/1.3 var(--serif); margin-top: 3px; font-variant-numeric: tabular-nums; }
.stat .v.green { color: var(--green); }
.stat .v.amber { color: var(--amber); }
.stat .v.red { color: var(--red); }

/* ---------- timing ---------- */
.timing { margin: -8px 0 18px; }
.timing-body {
  margin-top: 8px; padding: 12px 14px;
  background: var(--paper); border: 1px solid var(--border);
}
.timing-phases {
  display: flex; flex-wrap: wrap; gap: 18px;
  font: 12px var(--mono); color: var(--muted);
  padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px dashed var(--border);
}
.timing-phases strong { color: var(--ink); font-variant-numeric: tabular-nums; }
.timing-table { font-size: 12.5px; border: 0; }
.timing-table th, .timing-table td { padding: 5px 10px 5px 0; }
.timing-table td.dim { color: var(--muted); font-family: var(--mono); font-size: 11.5px; }
.timing-table tbody tr:hover { background: transparent; }
.timing-note { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); }
.timing-note.warnish { color: var(--amber); }

/* ---------- fields ---------- */
.section-title {
  font: 700 11.5px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted);
  margin: 26px 0 10px; padding-bottom: 5px; border-bottom: 1px solid var(--border);
}

.field {
  background: var(--paper); border: 1px solid var(--panel-2);
  border-left: 3px solid var(--border-strong);
  padding: 11px 15px; margin-bottom: 6px;
}
.field.auto_accept { border-left-color: var(--green); }
.field.review      { border-left-color: var(--amber); }
.field.reject      { border-left-color: var(--red); }
.field.corrected   { border-left-color: var(--accent); background: var(--accent-ink); }

.field-top { display: flex; align-items: center; gap: 12px; }
.field-label { width: 140px; flex-shrink: 0; color: var(--muted); font-size: 12.5px; }
.field-value { flex: 1; font: 550 14px var(--mono); word-break: break-word; }
.field-value.empty { color: var(--muted); font-weight: 400; font-style: italic; font-family: var(--sans); }

.conf { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.bar { width: 74px; height: 4px; background: var(--panel-2); overflow: hidden; }
.bar > i { display: block; height: 100%; }
.conf-num { font-variant-numeric: tabular-nums; font: 13px var(--mono); width: 38px; text-align: right; }

.icon { font-size: 13px; width: 16px; text-align: center; font-family: var(--serif); }

.field input {
  flex: 1; background: var(--paper); color: var(--ink); font-family: var(--mono);
  border: 1px solid var(--accent); border-radius: var(--radius); padding: 5px 9px;
}
.linkbtn { background: none; border: 0; color: var(--accent); font-size: 12px; padding: 2px 4px; text-decoration: underline; text-underline-offset: 2px; }

.why { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--border); font-size: 12.5px; color: var(--muted); }
.why ul { margin: 6px 0 0; padding-left: 18px; }
.signals { display: flex; gap: 16px; flex-wrap: wrap; font-variant-numeric: tabular-nums; font-family: var(--mono); }

/* ---------- table ---------- */
table { width: 100%; border-collapse: collapse; background: var(--paper); border: 1px solid var(--border); font-size: 13.5px; }
th { text-align: left; color: var(--muted); font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .05em; }
th, td { padding: 9px 13px; border-bottom: 1px solid var(--panel-2); }
tr:last-child td { border-bottom: 0; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--mono); }
tbody tr:hover { background: var(--panel-2); }

/* ---------- misc ---------- */
.warn { background: #f4e6c4; border: 1px solid #c9a344; color: #6b4f0d; border-radius: var(--radius); padding: 11px 14px; margin-bottom: 14px; font-size: 13.5px; }
.err  { background: #f4dcd5; border: 1px solid #c76a51; color: #7a2c17; border-radius: var(--radius); padding: 11px 14px; margin: 14px 0; font-size: 13.5px; }
.muted { color: var(--muted); font-size: 13px; }

.spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--panel-2); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; vertical-align: -3px; margin-right: 7px; }
@keyframes spin { to { transform: rotate(360deg); } }
